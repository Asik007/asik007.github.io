---
interface Props {
  title?: string;
  description?: string;
  all_link?: URL;
}

const { title = '', description = '', all_link = '' } = Astro.props;

const id = `carousel-${Math.random().toString(36).slice(2, 9)}`;
---

<div class="wrapper pt-1 pb-1">
	{(title || description) && (
      <div class="flex  items-center mb-2">
        {title && <h class="text-xl font-semibold leading-tight pr-2 border-r-2
		border-solid border-[var(--theme-accent)] font-weight-medium">{title}</h>}
		
        {description && <p class="text-sm leading-snug text-center	pl-2">{description}</p>}
    {all_link && (
      <a
        href={all_link}
        class="flex-1 text-sm font-medium underline underline-offset-2 hover:opacity-70 text-right"
      >
        View all
      </a>
    )}
      </div>
    )}

  <div class="flex items-center gap-4" id={id}>
    <!-- Title/description sit inline with the carousel controls, not stacked above them -->
    

    <button type="button" class="carousel-btn" aria-label="Scroll left" data-dir="prev">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M15 4l-8 8 8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>

    <div
      class="carousel-track flex flex-1 gap-5 overflow-x-auto snap-x snap-proximity scroll-smooth motion-reduce:scroll-auto pt-1 px-[0.15rem] pb-3
        [&::-webkit-scrollbar]:h-1.5
        [&::-webkit-scrollbar-thumb]:bg-[var(--theme-border,#9d3723)]
        [&::-webkit-scrollbar-thumb]:opacity-40
        [&::-webkit-scrollbar-thumb]:rounded-[3px]
        [&>*]:flex-none [&>*]:w-[min(260px,78vw)] [&>*]:snap-start"
    >
      <slot />
    </div>

    <button type="button" class="carousel-btn" aria-label="Scroll right" data-dir="next">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path
          d="M9 4l8 8-8 8"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </button>


  </div>
</div>






<script define:vars={{ id }}>
  const root = document.getElementById(id);
  const track = root.querySelector('.carousel-track');
  const prevBtn = root.querySelector('[data-dir="prev"]');
  const nextBtn = root.querySelector('[data-dir="next"]');

  function step() {
    const firstCard = track.querySelector(':scope > *');
    const gap = parseFloat(getComputedStyle(track).columnGap || '20');
    return firstCard ? firstCard.getBoundingClientRect().width + gap : 280;
  }

  function updateButtons() {
    const max = track.scrollWidth - track.clientWidth - 1;
    prevBtn.disabled = track.scrollLeft <= 0;
    nextBtn.disabled = track.scrollWidth <= track.clientWidth || track.scrollLeft >= max;
  }

  prevBtn?.addEventListener('click', () => {
    track.scrollBy({ left: -step(), behavior: 'smooth' });
  });
  nextBtn?.addEventListener('click', () => {
    track.scrollBy({ left: step(), behavior: 'smooth' });
  });
  track?.addEventListener('scroll', updateButtons, { passive: true });
  window.addEventListener('resize', updateButtons);
  updateButtons();
</script>