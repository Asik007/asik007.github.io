---
import { Image } from 'astro:assets';

interface Post {
  data: {
    title: string;
    description?: string;
    heroImage?: string;
    pubDate?: Date | string;
    tags?: string[];
  };
  id: string;
  url: string;
  collection: string;
}

type Props = {
  postObject: Post;
};




const { postObject } = Astro.props;
const { data, id, url } = postObject;

const { title, description, heroImage: thumbnail, tags = [], pubDate: rawDate } = data;

// Safe date parsing
const date = rawDate ? new Date(rawDate instanceof Date ? rawDate : rawDate) : null;

const formattedDate = date?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}) ?? null;

console.log('url:', postObject.collection);
---

<div class="cv-card hover-scale-105">
  <a href={`/projects/${id}/`} style="display: block;">
    {thumbnail && (
      <div class="card-thumbnail">
        <Image src={thumbnail} alt={title} />
      </div>
    )}
    <div class="post-link border-l-2 border-(--color-accent)">
      <h3 class="card-title font-weight-medium pl-2">
        {title}
      </h3>
      {formattedDate && <time class="post-date pl-2">{formattedDate}</time>}
    </div>
  </a>

  {tags.length > 0 && (
    <div class="post-tags flex flex-wrap items-center gap-0.5 text-sm pt-2" data-tags={tags.join(',')}>
      {tags.map((tag, index) => (
        <>
          {index > 0 && <span class="tag-separator"> · </span>}
          <a
            class="tag-card-link cursor-pointer hover:underline transition-colors"
            href={`${Astro.url.origin}/${postObject.collection}/?tag=${tag}`}
          >{tag}</a>
        </>
      ))}
    </div>
  )}

  <a href={`/projects/${id}/`} style="display: block;">
    {description && <p class="card-text font-light text-sm mt-2">{description}</p>}
  </a>
</div>