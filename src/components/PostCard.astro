---
import { Image } from 'astro:assets';

interface Post {
  data: {
    title: string;
    description?: string;
    heroImage?: string;
    pubDate?: Date | string;
    tags?: string[];
  };
  id: string;
  url: string;
}

type Props = {
  postObject: Post;
};

const { postObject } = Astro.props;
const { data, id, url } = postObject;

const { title, description, heroImage: thumbnail, tags = [], pubDate: rawDate } = data;

// Safe date parsing
const date = rawDate ? new Date(rawDate instanceof Date ? rawDate : rawDate) : null;

const formattedDate = date?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}) ?? null;


---

<a href={`/projects/${id}/`} class="cv-card hover-scale-105" style="display: block;">
  {thumbnail && (
    <div class="card-thumbnail">
      <Image src={thumbnail} alt={title} />
    </div>
  )}
  
  <div class="post-link">
    <h3 class="card-title font-weight-medium border-l-2 pl-2 border-(--color-border)">
      {title}
    </h3>
    {formattedDate && <time class="post-date">{formattedDate}</time>}
  </div>
  
  {tags.length > 0 && (
    <div class="post-tags" data-tags={tags.join(',')}>
      {tags.map((tag, index) => (
        <>
          {index > 0 && <span class="tag-separator"> · </span>}
          <span class="tag-link" onclick="">{tag}</span>
        </>
      ))}
    </div>
  )}
  
  {description && <p class="card-text font-light text-sm mt-2">{description}</p>}
</a>