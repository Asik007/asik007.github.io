---
interface Props {
  title: string;
  subtitle?: string;
  location?: string;
  dates?: string;
  highlights?: string[];
  url?: string;
}

const { title, subtitle, location, dates, highlights = [], url } = Astro.props;
---



<li class="item">
  <div class="content">
    {/* Header: Title + Date Badge */}
    <div class="header">
      <div>
        {url ? (
          <h6 class="title">
            <a href={url} target="_blank" rel="noopener noreferrer" class="title-link">
              {title}
            </a>
          </h6>
        ) : (
          <h6 class="title">{title}</h6>
        )}
      </div>
      {dates && <span class="dates">{dates}</span>}
    </div>

    {/* Subtitle + Location */}
    {(subtitle || location) && (
      <div class="meta">
        {subtitle && <p>{subtitle}</p>}
        {location && <p class="location">{location}</p>}
      </div>
    )}

    {/* Highlights */}
    {highlights.length > 0 && (
      <ul class="highlights">
        {highlights.map((highlight) => (
          <li class="highlight-item">
            <span class="highlight-bullet">•</span>
            <span set:html={highlight} />
          </li>
        ))}
      </ul>
    )}
  </div>
</li>


<style>
  .item {
    display: flex;
    gap: 1.5rem;
    padding: 1rem 0;
  }

  .item:last-child {
    border-bottom: none;
  }

  .content {
    flex: 1;
    min-width: 0;
  }

  .header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .title {
    font-size: 1.25rem;
    font-weight: bold;
    transition: color 0.2s;
    color: var(--color-text-bold); 
    /* bold means the text should be darker in light and lighter in dark */
    margin: 0;
  }

  .title-link {
    color: inherit;
    text-decoration: none;
  }

  .title-link:hover {
    text-decoration: underline;
  }

  .dates {
    display: inline-block;
    white-space: nowrap;
    font-size: 1rem;
    font-weight: bold;
    text-transform: uppercase;
    flex-shrink: 0;
    color: var(--color-secondary);
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .meta p {
    margin: 0;
  }

  .location {
    text-align: right;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-left: 1rem;
    font-size: 0.875rem;
    color: var(--color-secondary);
  }

  .highlight-item {
    display: flex;
    gap: 0.5rem;
  }

  .highlight-bullet {
    flex-shrink: 0;
    color: var(--color-accent);
  }
</style>