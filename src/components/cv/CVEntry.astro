---
interface Props {
  title: string;
  subtitle?: string;
  location?: string;
  dates?: string;
  highlights?: string[];
  url?: string;
}

const { title, subtitle, location, dates, highlights = [], url } = Astro.props;
---

<li class="flex gap-6 last:border-b-0">
  <div class="flex-1 min-w-0">
    {/* Header: Title + Date Badge */}
    <div class="flex items-start justify-between gap-4 mb-2">
      <div>
        {url ? (
          <h6 class="text-xl font-bold transition-colors" style="color: var(--color-text);">
            <a href={url} target="_blank" rel="noopener noreferrer" 
            class="hover:underline" style="color: var(--color-text);">
              {title}
            </a>
          </h6>
        ) : (
          <h6 class="text-xl font-bold" style="color: var(--color-text);">{title}</h6>
        )}
      </div>
      {dates && (
        <span class="inline-block whitespace-nowrap text-md font-bold uppercase flex-shrink-0" style="color: var(--color-danger-dark); background-color: var(--color-danger-light);">
          {dates}
        </span>
      )}
    </div>

    {/* Subtitle + Location */}
    {(subtitle || location) && (
      <div class="flex items-center justify-between gap-4 mb-3 text-sm">
        {subtitle && <p style="color: var(--color-text-secondary);">{subtitle}</p>}
        {location && <p class="text-right" style="color: var(--color-text-secondary);">{location}</p>}
      </div>
    )}

    {/* Highlights */}
    {highlights.length > 0 && (
      <ul class="space-y-2 ml-4 text-sm" style="color: var(--color-text);">
        {highlights.map((highlight) => (
          <li class="flex gap-2">
            <span class="flex-shrink-0" style="color: var(--color-accent);">•</span>
            <span set:html={highlight} />
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
