---
import { GITHUB_PROFILE_URL, LINKED_IN_URL, SITE_TITLE, NAV_LINKS } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header class="px-4 shadow-md" style="background-color: var(--color-primary); color: var(--color-secondary);">
    <nav class="flex items-center justify-between">


        <h2 class="m-0 text-base">
            <a href="/" class="no-underline">
                {SITE_TITLE}
            </a>
        </h2>
        
		<div class="flex items-center gap-3" justify-between>

			<!-- Dark and Light Mode Toggle -->
			<div class="flex items-center">
				<button id="theme-toggle" class="p-2 rounded-full hover:bg-gray-200">
					<span class="sr-only">Toggle theme</span>
					<svg id="theme-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
					</svg>
				</button>
			</div>

			<!-- Navigation Links -->
			<div class="flex justify-baseline gap-2">
				{NAV_LINKS.map((link) => (
					<HeaderLink href={link.href}>{link.title}</HeaderLink>
				))}
			</div>



			<!-- Social Media Links -->
			<div class="flex justify-center gap-2">
				<a href={LINKED_IN_URL} target="_blank" class="text-black hover:opacity-70 transition-opacity">
					<span class="sr-only">Linked-in Profile</span>
					<svg viewBox="9 9 53 52" xml:space="preserve" aria-hidden="true" width="32" height="31">
						<path 
						xmlns="http://www.w3.org/2000/svg"
						fill="currentColor" 
						d="M62,62 L51.315625,62 L51.315625,43.8021149 C51.315625,38.8127542 49.4197917,36.0245323 45.4707031,36.0245323 C41.1746094,36.0245323 38.9300781,38.9261103 38.9300781,43.8021149 L38.9300781,62 L28.6333333,62 L28.6333333,27.3333333 L38.9300781,27.3333333 L38.9300781,32.0029283 C38.9300781,32.0029283 42.0260417,26.2742151 49.3825521,26.2742151 C56.7356771,26.2742151 62,30.7644705 62,40.051212 L62,62 Z M16.349349,22.7940133 C12.8420573,22.7940133 10,19.9296567 10,16.3970067 C10,12.8643566 12.8420573,10 16.349349,10 C19.8566406,10 22.6970052,12.8643566 22.6970052,16.3970067 C22.6970052,19.9296567 19.8566406,22.7940133 16.349349,22.7940133 Z M11.0325521,62 L21.769401,62 L21.769401,27.3333333 L11.0325521,27.3333333 L11.0325521,62 Z"
						/>
					</svg>
				</a>
				<a href={GITHUB_PROFILE_URL} target="_blank" class="text-black hover:opacity-70 transition-opacity">
					<span class="sr-only">Github</span>
					<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>

			</div>
			


		</div>
    </nav>
</header>