---
export interface Props {
  items: TocItem[];
}

export type TocItem = {
  label: string;
  href: string;
};

const { items } = Astro.props;
---

{items.length > 0 && (
    <nav
        class="hidden md:block shrink sticky top-20 max-h-[calc(100vh-100px)] overflow-y-auto"
        style="
        color: var(--color-secondary);
        "
        aria-label="CV sections"
    >
        <ul class="list-none p-1 m-0 shrink">
        {items.map((item) => (
            <li key={item.href} class="border-r-2 border-transparent transition-ease-in-out 
                hover:scale-105 hover:-translate-x-0.5 hover:border-r-(--color-border) text-right">
            <a
                href={item.href}
                class=" py-1 text-sm p-1 font-mono whitespace-nowrap inline-block max-w-[200px] overflow-clip text-ellipsis"
                style="
                color: var(--color-secondary);
                background-color: var(--color-primary);                
                "
            >
                {item.label}
            </a>
            </li>
        ))}
        </ul>
    </nav>
)}