---
export interface Props {
  items: TocItem[];
}

export type TocItem = {
  label: string;
  href: string;
};

const { items } = Astro.props;
---

{items.length > 0 && (
    <div class="toc-container p-8 sticky">
    <nav
        class="hidden md:block shrink-0 w-44 sticky top-20 max-h-[calc(100vh-100px)] overflow-y-auto"
        style="
        color: var(--color-secondary);
        border-radius: 0.5rem;
        border-color: var(--color-border);
        border-width: 3px;
        "
        aria-label="CV sections"
    >
        <ul class="list-none p-0 m-0">
        {items.map((item) => (
            <li key={item.href}>
            <a
                href={item.href}
                class="block py-1 pl-3 text-sm no-underline transition-ease-in-out font-mono hover:border-b-2 hover:scale-105"
                style="
                color: var(--color-secondary);
                background-color: var(--color-primary);
                border-color: var(--color-border);
                "
            >
                {item.label}
            </a>
            </li>
        ))}
        </ul>
    </nav>
    </div>
)}