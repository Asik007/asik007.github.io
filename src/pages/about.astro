---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';
import Carousel from '../components/Carousel.astro';
import { GITHUB_PROFILE_URL, LINKED_IN_URL } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const projects = (await getCollection('projects'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout
	title="About Me"
	description="A bit about who's behind this site, plus a few recent posts and projects."
	pubDate={new Date('August 08 2021')}
	heroImage={AboutHeroImage}
>
	<p>
		Hi, I'm Advik — welcome. This site is where I write up what I've been
		building, which tends to land somewhere between mechanical design,
		embedded electronics, and computer vision. Recent projects have
		included a lab tool for counting droplets under a microscope, a
		custom wireless keyboard PCB, and an FPGA rig that streams frames
		over Ethernet for oscilloscope art.
	</p>
	<p>
		[Add a couple of sentences here about what you're doing right now —
		school, work, or otherwise. It's the one thing your project list
		can't say for you.]
	</p>
	<p>
		The full write-ups live on the <a href="/blog">blog</a> and
		<a href="/projects">projects</a> pages, and if you'd rather see the
		resume version, there's a <a href="/CV">CV</a> too. You can also find
		me on <a href={GITHUB_PROFILE_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
		and <a href={LINKED_IN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>.
	</p>

	<section class="stack">
		<div class="stack-header">
			<h2>Recent posts</h2>
			<a href="/blog">See all posts</a>
		</div>
		{posts.length > 0 ? (
			<Carousel>
				{posts.map((post) => (
					<a class="cv-card card-link flex flex-col" href={`/blog/${post.id}/`}>
						{post.data.heroImage && (
							<Image
								class="card-image"
								src={post.data.heroImage}
								alt=""
								width={280}
								height={150}
							/>
						)}
						<h3 class="card-title font-weight-medium border-l-2 pl-2 border-(--color-border)">
							{post.data.title}
						</h3>
						<p class="card-text font-light text-sm mt-2">{post.data.description}</p>
					</a>
				))}
			</Carousel>
		) : (
			<p class="card-text font-light text-sm">No posts published yet — check back soon.</p>
		)}
	</section>

	<section class="stack">
		<div class="stack-header">
			<h2>Recent projects</h2>
			<a href="/projects">See all projects</a>
		</div>
		{projects.length > 0 ? (
			<Carousel>
				{projects.map((project) => (
					<a class="cv-card card-link flex flex-col" href={`/projects/${project.id}/`}>
						{project.data.heroImage && (
							<Image
								class="card-image"
								src={project.data.heroImage}
								alt=""
								width={280}
								height={150}
							/>
						)}
						<h3 class="card-title font-weight-medium border-l-2 pl-2 border-(--color-border)">
							{project.data.title}
						</h3>
						<p class="card-text font-light text-sm mt-2">{project.data.description}</p>
						{project.data.tags && project.data.tags.length > 0 && (
							<p class="card-tags">{project.data.tags.slice(0, 3).join(' · ')}</p>
						)}
					</a>
				))}
			</Carousel>
		) : (
			<p class="card-text font-light text-sm">Nothing listed yet.</p>
		)}
	</section>
</Layout>

<style>
	.stack {
		margin-top: 2.5rem;
	}
	.stack-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		border-bottom: 1px solid var(--theme-border, #9d3723);
		padding-bottom: 0.4rem;
		margin-bottom: 1rem;
	}
	.stack-header h2 {
		margin: 0;
	}
	.stack-header a {
		font-size: 0.9rem;
		white-space: nowrap;
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	.card-link {
		text-decoration: none;
		transition: box-shadow 0.15s ease, border-color 0.15s ease;
	}
	.card-link:hover {
		border-color: var(--theme-accent, #2e3526);
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
	}
	.card-image {
		width: 100%;
		height: 140px;
		object-fit: cover;
		border-radius: 0.25rem;
		margin-bottom: 0.5rem;
	}
	.card-tags {
		margin: 0.5rem 0 0;
		font-size: 0.75rem;
		opacity: 0.75;
	}
</style>