---
import Basic from '../layouts/Basic.astro';
import Carousel from '../components/Carousel.astro';
import PostCard from '../components/PostCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE, GITHUB_PROFILE_URL, LINKED_IN_URL } from '../consts';
import { Image } from 'astro:assets';

---

<Basic>
	<div class="hero pt-10 grid grid-cols-2 place-items-center ">

		<p class="text-center ">
			Welcome to my site! This is where I write up what I've been
			building/doing, which lies somewhere between mechanical design,
			embedded electronics, computer vision, and biology. By training I
			am a bioengineer, but who cares about titles. I just want to do
			whatever scratches that oh so ellusive itch in my brain.
		</p>
		<div class="hero-media">
			<Image src="/src/content/cv/cv-image.jpg" alt="Advik's profile picture"
				width={260} height={260}/>
			<div class="hero-links">
				<a href={GITHUB_PROFILE_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
				<a href={LINKED_IN_URL} target="_blank" rel="noopener noreferrer">LinkedIn</a>
			</div>
		</div>
	</div>

	<Carousel title="Recent Projects" description="A few of the recent projects I've been working on." all_link="/blog">
		<PostCard postObject={{ data: { title: 'Post 1', description: 'Description for Post 1', pubDate: '2024-01-01' }, id: 'post-1', url: '/blog/post-1/' }} />
		<PostCard postObject={{ data: { title: 'Post 2', description: 'Description for Post 2', pubDate: '2024-02-01' }, id: 'post-2', url: '/blog/post-2/' }} />
		<PostCard postObject={{ data: { title: 'Post 3', description: 'Description for Post 3', pubDate: '2024-03-01' }, id: 'post-3', url: '/blog/post-3/' }} />
	</Carousel>

	<Carousel title="Recent posts" description="A few of my most recent blog posts.">
		<PostCard postObject={{ data: { title: 'Post 1', description: 'Description for Post 1', pubDate: '2024-01-01' }, id: 'post-1', url: '/blog/post-1/' }} />
		<PostCard postObject={{ data: { title: 'Post 2', description: 'Description for Post 2', pubDate: '2024-02-01' }, id: 'post-2', url: '/blog/post-2/' }} />
		<PostCard postObject={{ data: { title: 'Post 3', description: 'Description for Post 3', pubDate: '2024-03-01' }, id: 'post-3', url: '/blog/post-3/' }} />
	</Carousel>

</Basic>

<style>
  .hero {
    overflow: hidden; /* clearfix so the section wraps its floated child */
  }

  .hero-media {
    float: right;
    width: 260px;
    margin: 0 0 1.5rem 2rem;
  }

  .hero-image {
    display: block;
    width: 100%;
    border-radius: 12px;
    object-fit: cover;
  }

  .hero-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 0.75rem;
    font-size: 0.9rem;
  }

  .hero-links a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  @media (max-width: 640px) {
    .hero-media {
      float: none;
      width: 100%;
      margin: 0 0 1.5rem 0;
    }
  }
</style>