---
import PostCard from '../../components/PostCard.astro';
import Page from '../../layouts/Basic.astro';
import { getCollection } from 'astro:content';

interface Post {
  data: {
    title: string;
    description: string;
    heroImage?: string;
    tags?: string[];
  };
  url: string;
}

const projects = (await getCollection('projects')) as Post[];

---

<Page site_title="Projects" description="Projects by">
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">projects</h1>
      <p class="post-description">A collection of my projects.</p>
    </header>

    <article>
      <div class="projects">
        {projects.length === 0 ? (
          <p class="no-projects">No projects yet.</p>
        ) : (
			<div class="projects-grid">
				{projects.map((project) => (
				<PostCard postObject={project} />
				))}
			</div>
        )}
      </div>
    </article>
  </div>
</Page>

<style>
  /* ── Page structure ─────────────────────────────────────────────────────── */
  .post {
    padding-top: 0;
  }

  .post-description {
    color: var(--global-text-color-light);
    font-size: 1rem;
    margin: 0;
  }

  .no-projects {
    color: var(--global-text-color-light);
    font-size: 1rem;
  }

  /* ── Projects container ─────────────────────────────────────────────────── */
  .projects a {
    text-decoration: none;
  }

  /* Category sections */
  .category-section {
    margin-bottom: 3rem;
  }

  /* Category headings — right-aligned with divider (matches al-folio) */
  h2.category {
    color: var(--global-divider-color);
    border-bottom: 1px solid var(--global-divider-color);
    padding-bottom: 0.5rem;
    margin-top: 2rem;
    margin-bottom: 1.5rem;
    text-align: right;
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    text-transform: lowercase;
  }

  /* ── Responsive grid ─────────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 0;
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>