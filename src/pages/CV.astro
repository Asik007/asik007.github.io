---
import CVEntry from '../components/cv/CVEntry.astro';
import CVSection from '../components/cv/CVSection.astro';
import TableContent from '../components/TableContent.astro';

import { Image } from 'astro:assets';
import pdfIcon from '../assets/pdf.svg'; 
import { CV_PDF_PATH } from '../consts';
// import { site } from '../config/site';
import Page from '../layouts/Basic.astro';
// import { withBase } from '../utils/base';
// import type { JSONResume, RenderCV, RenderCVEntry } from '../utils/cv';
import { formatCVDate, formatDateRange } from '../utils/cv';



import {getCollection} from 'astro:content';
// Get the single CV entry
const cvEntries = await getCollection('cv');
const cvEntry = cvEntries[0]; // Get the first (and only) entry

// const format = site.cv.format;
const format = 'rendercv'; // or 'jsonresume' depending on your data

const rc = cvEntry.data ?? null;
const education = rc?.sections?.education ?? [];
const experience = rc?.sections?.experience ?? [];
const rcPublications = rc?.sections?.publications ?? [];
const awards = rc?.sections?.awards ?? [];
const skills = rc?.sections?.skills ?? []
const interests = rc?.sections?.interests ?? [];

// console.log('CV Entry:', rc);
// console.log('Education:', education);
// console.log('Experience:', experience);
// console.log('Publications:', rcPublications);
// console.log('Awards:', awards);
// console.log('Skills:', skills);
// console.log('Interests:', interests);

// Build sidebar TOC items based on which sections have data
type TocItem = { label: string; href: string };

const tocItems: TocItem[] = [];
if (format === 'rendercv' && rc) {
  if (rc.name || rc.email || rc.phone) tocItems.push({ label: 'Contact Information', href: '#contact' });
  if (rc.summary) tocItems.push({ label: 'Professional Summary', href: '#summary' });
  if (education.length > 0) tocItems.push({ label: 'Education', href: '#education' });
  if (experience.length > 0) tocItems.push({ label: 'Experience', href: '#experience' });
  if (rcPublications.length > 0) tocItems.push({ label: 'Publications', href: '#publications' });
  if (awards.length > 0) tocItems.push({ label: 'Awards', href: '#awards' });
  if (skills.length > 0) tocItems.push({ label: 'Skills', href: '#skills' });
  if (interests.length > 0) tocItems.push({ label: 'Interests', href: '#interests' });
}

// console.log('TOC Items:', tocItems);
---
<Page fg_color='var(--color-primary)' tocItems={tocItems}> >
  <div class="post">
    <!-- Header -->

    <!-- Body -->
   <article >
      
        <!-- Main CV content – fills remaining space -->
      <div class="flex-1 min-w-0 cv-content" >
        
            <header class="post-header">
              <h1 class="post-title text-center">
                {rc.name ?? 'Curriculum Vitae'}
              </h1>
            </header>
        <!-- ── RENDERCV ──────────────────────────────────────────────── -->
        <>
          {rc && (rc.name || rc.email || rc.phone || rc.website || rc.location) && (
            <>
              <a class="anchor" id="contact" />
              <div class="cv-card">
                <h3 class="card-title font-weight-medium">Contact Information</h3>
                <table class="table table-cv table-sm table-borderless">
                  {rc.email && (
                    <tr>
                      <td class="p-1 pr-2 font-bold">Email</td>
                      <td class="p-1 pl-2 font-light">{rc.email}</td>
                    </tr>
                  )}
                  {/* {rc.phone && (
                    <tr>
                      <td class="p-1 pr-2 font-bold">Phone</td>
                      <td class="p-1 pl-2 font-light">{rc.phone}</td>
                    </tr>
                  )} */}
                  {rc.location && (
                    <tr>
                      <td class="p-1 pr-2 font-bold">Location</td>
                      <td class="p-1 pl-2 font-light">{rc.location}</td>
                    </tr>
                  )}
                </table>
              </div>
            </>
          )}

          {rc?.summary && (
            <>
              <a class="anchor" id="summary" />
              <div class="cv-card">
                <h3 class="card-title font-weight-medium">Professional Summary</h3>
                <p class="card-text font-light text-sm">{rc.summary}</p>
              </div>
            </>
          )}

          {education.length > 0 && (
            <CVSection title="Education" id="education">
              <div class="card-body">
                  <ul class="card-text font-light list-group list-group-flush">
                    {experience.map((e, index) => (
                      <div key={e.id}>
                        {index > 0 && (<hr class="divider" />)}
                        <CVEntry
                          key={e.id}
                          title={e.position ?? ''}
                          subtitle={e.company}
                          location={e.location}
                          dates={formatDateRange(e.start_date, e.end_date)}
                          highlights={e.highlights}
                      />
                    </div>
                  ))}
                </ul>
              </div>
            </CVSection>
          )}

          {experience.length > 0 && (
            <CVSection title="Experience" id="experience">
              <ul class="card-text font-light list-group list-group-flush">
                {experience.map((e, index) => (
                  <div key={e.id} style="margin-bottom: 1rem;">
                    {index > 0 && (<hr class="divider" />)}
                    <CVEntry
                      key={e.id}
                      title={e.position ?? ''}
                      subtitle={e.company}
                      location={e.location}
                      dates={formatDateRange(e.start_date, e.end_date)}
                      highlights={e.highlights}
                    />
                  </div>
                ))}
              </ul>
            </CVSection>
          )}

          {rcPublications.length > 0 && (
            <CVSection title="Selected Publications" id="publications">
              <ul class="card-text font-light list-group list-group-flush">
                {rcPublications.map((e, index) => (
                  <div>
                    {index > 0 && (<hr class="divider" />)}
                    <CVEntry
                      key={e.id}
                      title={e.title ?? ''}
                      subtitle={[e.authors?.join(', '), e.journal].filter(Boolean).join(' — ')}
                      dates={formatCVDate(e.date)}
                      url={e.doi ? `https://doi.org/${e.doi}` : e.url}
                    />
                </div>
                ))}
              </ul>
            </CVSection>
          )}

          {awards.length > 0 && (
            <CVSection title="Honors & Awards" id="awards">
              <ul class="card-text font-light list-group list-group-flush">
                {awards.map((e, index) => (
                  <div>
                    {index > 0 && (<hr class="divider" />)}
                    <CVEntry
                      key={e.id}
                      title={e.name ?? ''}
                      subtitle={e.issuer}
                      dates={formatCVDate(e.date)}
                      highlights={e.highlights}
                    />
                  </div>
                ))}
              </ul>
            </CVSection>
          )}

          {skills.length > 0 && (
            <CVSection title="Skills" id="skills">
              <div class="card-text font-light">
                {skills.map((e) => (
                  <div class="skill-item text-md" key={e.id}>
                    <strong>{e.label}:</strong> {e.details}
                  </div>
                ))}
              </div>
            </CVSection>
          )}

          {interests.length > 0 && (
            <CVSection title="Interests" id="interests">
              <div class="card-text font-light">
                {interests.map((e) => (
                  <div class="skill-item" key={e.id}>
                    <strong>{e.label}:</strong> {e.details}
                  </div>
                ))}
              </div>
            </CVSection>
          )}
        </>
      </div>

      <!-- Floating button: placed here, outside the wrapper -->
      <a
        
        href={CV_PDF_PATH}
        target="_blank"
        rel="noopener noreferrer"
        class="fixed bottom-6 right-6 z-50 inline-flex items-center gap-2 px-4 py-3 rounded-full shadow-lg transition-shadow ease-in-out hover:ring-2 hover:ring-(--color-border)" 
        style="background-color: var(--color-secondary); color: var(--color-primary); focus:ring-color: var(--color-border);"
        aria-label="Download CV PDF"
      >
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          viewBox="0 0 576 512"
          width={20}
          height={20}
          style={{ fill: 'var(--color-primary)' }}
        >
          <path d="M96 0C60.7 0 32 28.7 32 64l0 384c0 35.3 28.7 64 64 64l80 0 0-112c0-35.3 28.7-64 64-64l176 0 0-165.5c0-17-6.7-33.3-18.7-45.3L290.7 18.7C278.7 6.7 262.5 0 245.5 0L96 0zM357.5 176L264 176c-13.3 0-24-10.7-24-24L240 58.5 357.5 176zM240 380c-11 0-20 9-20 20l0 128c0 11 9 20 20 20s20-9 20-20l0-28 12 0c33.1 0 60-26.9 60-60s-26.9-60-60-60l-32 0zm32 80l-12 0 0-40 12 0c11 0 20 9 20 20s-9 20-20 20zm96-80c-11 0-20 9-20 20l0 128c0 11 9 20 20 20l32 0c28.7 0 52-23.3 52-52l0-64c0-28.7-23.3-52-52-52l-32 0zm20 128l0-88 12 0c6.6 0 12 5.4 12 12l0 64c0 6.6-5.4 12-12 12l-12 0zm88-108l0 128c0 11 9 20 20 20s20-9 20-20l0-44 28 0c11 0 20-9 20-20s-9-20-20-20l-28 0 0-24 28 0c11 0 20-9 20-20s-9-20-20-20l-48 0c-11 0-20 9-20 20z"/>
        </svg>
        <span class="text-sm font-medium hidden sm:inline">Download PDF</span>
      </a>

    </article>
  </div>
</Page>