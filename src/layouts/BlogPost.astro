---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './Basic.astro';

type Props = CollectionEntry<'blog'>['data'] & {
  tocItems?: { label: string; href: string }[];
};

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags = [],
} = Astro.props;

const exampleToC = [
  { label: 'Introduction', href: '#introduction' },
  { label: 'Main Content', href: '#main-content' },
  { label: 'Conclusion', href: '#conclusion' },
];

const tocItems = Astro.props.tocItems || exampleToC;

// --- Minimal SEO helpers ---
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = heroImage
  ? new URL(typeof heroImage === 'string' ? heroImage : heroImage.src, Astro.site)
  : undefined;
---

<BaseLayout tocItems={tocItems}>


  <article class="blog-post">
    <!-- <div class="prose border-2"> -->

      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href="/blog">Blog</a></li>
          <li aria-current="page">{title}</li>
        </ol>
      </nav>

      <div class="hero-image py-6">
        {heroImage && (
          <Image
            width={1020}
            height={510}
            src={heroImage}
            alt={heroImageAlt || title}
          />
        )}
      </div>

      <div class="title">
        <div class="date">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <div class="last-updated-on">
              Last updated on <FormattedDate date={updatedDate} />
            </div>
          )}
        </div>

        <h1>{title}</h1>

        {tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )}

        <hr />
      </div>

      <slot />
    <!-- </div> -->
  </article>
</BaseLayout>

<style>
  main {
    max-width: 100%;
    margin: 0;
  }
  .hero-image {
    width: 100%;
  }
  .hero-image img {
    display: block;
    margin: 0 auto;
    border-radius: 12px;
    box-shadow: var(--box-shadow);
  }
  .prose {
    max-width: calc(75%);
    margin: auto;
    padding: 1em;
    color: rgb(var(--gray-dark));
  }

  .breadcrumbs {
    margin-bottom: 1em;
    font-size: 0.85em;
    color: rgb(var(--gray));
  }
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin-left: 0.35em;
    color: rgb(var(--gray));
  }
  .breadcrumbs a {
    color: rgb(var(--gray));
    text-decoration: none;
  }
  .breadcrumbs a:hover {
    text-decoration: underline;
  }
  .breadcrumbs li[aria-current='page'] {
    color: rgb(var(--gray-dark));
    font-weight: 500;
  }

  .title {
    margin-bottom: 1em;
    padding: 1em 0;
    text-align: center;
    line-height: 1;
  }
  .title h1 {
    margin: 0 0 0.5em 0;
  }
  .date {
    margin-bottom: 0.5em;
    color: rgb(var(--gray));
  }
  .last-updated-on {
    font-style: italic;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5em;
    list-style: none;
    padding: 0;
    margin: 0.5em 0 1em;
  }
  .tag {
    font-size: 0.75em;
    padding: 0.25em 0.75em;
    border-radius: 999px;
    background: rgb(var(--gray-light, 230 230 230));
    color: rgb(var(--gray-dark));
  }
</style>