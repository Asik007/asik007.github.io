---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableContent from '../components/TableContent.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export interface Props {
  /** Page-specific title, e.g. "About" or "Blog Post: Astro Tips".
   *  Rendered in the document head as "<page title> | <site title>". */
  site_title?: string;
  /** Page-specific meta description. Falls back to the site-wide description. */
  description?: string;
  bg_color?: string;
  fg_color?: string;
  tocItems?: { label: string; href: string }[];
  /** Social/OG preview image URL. Falls back to the favicon. */
  image?: string;
}

const {
  site_title: pageTitle,
  description,
  bg_color,
  fg_color,
  tocItems,
  image,
} = Astro.props;

// Build a descriptive <title>:
//   - page title provided  -> "Page Title | Site Title"
//   - no page title        -> "Site Title"
//   - page title already contains the site title -> use it as-is (no duplication)
const documentTitle = pageTitle
  ? pageTitle.includes(SITE_TITLE)
    ? pageTitle
    : `${pageTitle} | ${SITE_TITLE}`
  : SITE_TITLE;

// Prefer the page's own description, otherwise fall back to the site default.
const metaDescription = description || SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={documentTitle} description={metaDescription} headerImage={image} />
    </head>
    <body style={`background-color: ${bg_color || 'var(--color-primary)'};`}>
        <Header />

        <main class="main-content" style={`color: ${fg_color || 'var(--color-secondary)'}; `}>
            <slot />
        </main>

        <Footer />
    </body>
</html>

<style>



    .main-content {
        /* flex: 1;                 takes the remaining space */
        min-width: 0;            /* prevent overflow */
        box-sizing: border-box;
        padding: 0 1rem;
        margin: 0 auto;
    }

    /* On smaller screens: stack ToC above content */
    @media (max-width: 1200px) {
        .page-wrapper {
            grid-template-columns: 1fr;   /* single column */
            gap: 2rem 0;                  /* vertical gap between stacked items */
            justify-items: center;        /* center the items horizontally (optional) */
        }

        .toc-sidebar {
            position: static;             /* no longer sticky */
            text-align: center;           /* optional */
            max-width: 100%;             /* allow full width */
            justify-self: stretch;        /* make it take full width if you want */
        }

        .main-content {
            justify-self: stretch;        /* takes full width */
        }
    }
</style>