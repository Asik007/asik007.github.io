---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableContent from '../components/TableContent.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export interface Props {
  /** Page-specific title, e.g. "About" or "Blog Post: Astro Tips".
   *  Rendered in the document head as "<page title> | <site title>". */
  site_title?: string;
  /** Page-specific meta description. Falls back to the site-wide description. */
  description?: string;
  bg_color?: string;
  fg_color?: string;
  tocItems?: { label: string; href: string }[];
  /** Social/OG preview image URL. Falls back to the favicon. */
  image?: string;
}

const {
  site_title: pageTitle,
  description,
  bg_color,
  fg_color,
  tocItems,
  image,
} = Astro.props;

// Build a descriptive <title>:
//   - page title provided  -> "Page Title | Site Title"
//   - no page title        -> "Site Title"
//   - page title already contains the site title -> use it as-is (no duplication)
const documentTitle = pageTitle
  ? pageTitle.includes(SITE_TITLE)
    ? pageTitle
    : `${pageTitle} | ${SITE_TITLE}`
  : SITE_TITLE;

// Prefer the page's own description, otherwise fall back to the site default.
const metaDescription = description || SITE_DESCRIPTION;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={documentTitle} description={metaDescription} headerImage={image} />
    </head>
    <body style={bg_color ? `background-color: ${bg_color};` : undefined} class="bg-primary">
        <Header />

        <main
            class="min-w-0 box-border w-full max-w-5xl mx-auto px-3 sm:px-4 md:px-6 text-secondary"
            style={fg_color ? `color: ${fg_color};` : undefined}
        >
            <slot />
        </main>

        <Footer />
    </body>
</html>