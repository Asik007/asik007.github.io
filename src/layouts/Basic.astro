---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import TableContent from '../components/TableContent.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

export interface Props {
  bg_color?: string;
  fg_color?: string;
  tocItems?: { label: string; href: string }[]; // Optional prop for TOC items
  image?: string; // Optional prop for the image. URL to the image
}

// const metaImage = Astro.props.image; // Default to favicon if no image is provided

const { bg_color, fg_color, tocItems, image } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} headerImage={image} />
    </head>
    <body style={`background-color: ${bg_color || 'var(--color-primary)'};`}>
        <Header />

        <div class="page-wrapper">
            <!-- Left: Table of Contents (sticky) -->
            <aside class="toc-sidebar">
                {tocItems && tocItems.length > 0 && <TableContent items={tocItems} />}
            </aside>

            <!-- Right: main content -->
            <main class="main-content" style={`color: ${fg_color || 'var(--color-secondary)'};`}>
                <slot />
            </main>
        </div>

        <Footer />
    </body>
</html>

<style>
    .page-wrapper {
        display: flex;
        flex-direction: row;
        align-items: flex-start;
        justify-content: center;
        gap: 2rem;               /* spacing between ToC and content */
        padding: 0 1rem;         /* 1rem on each side */
        max-width: 1200px;       /* optional: limits the overall width */
        margin: 0 auto;          /* centers the whole column */
    }

    .toc-sidebar {
        position: sticky;
        top: 2rem;
        flex-shrink: 0;          /* keep its own width */
        /* optional: set a max-width if the ToC gets too wide */
        max-width: 250px;
    }

    .main-content {
        flex: 1;                 /* takes the remaining space */
        min-width: 0;            /* prevent overflow */
        box-sizing: border-box;
    }

    /* On smaller screens: stack ToC above content */
    @media (max-width: 1200px) {
        .page-wrapper {
            flex-direction: column;
            align-items: stretch;
            gap: 1.5rem;
        }

        .toc-sidebar {
            position: static;    /* no longer sticky */
            max-width: none;
        }
    }
</style>